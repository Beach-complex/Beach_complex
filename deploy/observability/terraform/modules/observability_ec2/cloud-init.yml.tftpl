#cloud-config
package_update: true
package_upgrade: false

packages:
  - e2fsprogs
  - python3-minimal
  - util-linux

write_files:
  - path: /etc/docker/daemon.json
    owner: root:root
    permissions: "0644"
    content: |
      {
        "log-driver": "json-file",
        "log-opts": {
          "max-size": "50m",
          "max-file": "5"
        }
      }

  - path: /usr/local/sbin/verify-observability-mount
    owner: root:root
    permissions: "0755"
    encoding: b64
    content: ${mount_verifier_base64}

  - path: /run/beach-observability/docker-compose.yml
    owner: root:root
    permissions: "0644"
    encoding: gzip+base64
    content: ${compose_base64gzip}

  - path: /run/beach-observability/prometheus.yml
    owner: root:root
    permissions: "0644"
    encoding: gzip+base64
    content: ${prometheus_config_base64gzip}

  - path: /run/beach-observability/tempo.yaml
    owner: root:root
    permissions: "0644"
    encoding: gzip+base64
    content: ${tempo_config_base64gzip}

  - path: /run/beach-observability/grafana-datasources.yml
    owner: root:root
    permissions: "0644"
    encoding: gzip+base64
    content: ${grafana_datasources_base64gzip}

  - path: /etc/systemd/system/docker.service.d/observability-mount.conf
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      RequiresMountsFor=${mount_point}

      [Service]
      ExecStartPre=/usr/local/sbin/verify-observability-mount pre-docker

  - path: /etc/systemd/system/beach-observability.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Beach observability Compose services
      Requires=docker.service
      After=docker.service
      RequiresMountsFor=${mount_point}

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      WorkingDirectory=${mount_point}/compose
      ExecStartPre=/usr/local/sbin/verify-observability-mount healthy
      ExecStart=/usr/bin/docker compose up -d
      ExecStop=/usr/bin/docker compose down
      TimeoutStartSec=0

      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/sbin/bootstrap-beach-observability
    owner: root:root
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -Eeuo pipefail

      readonly expected_volume_id="$1"
      readonly requested_attachment_device="$2"
      readonly mount_point="$3"
      # The external EBS attachment can complete after cloud-init starts.
      # Match the AWS Provider's default five-minute attachment create timeout.
      readonly device_wait_seconds=300
      readonly virtualization_type="$(systemd-detect-virt --vm 2>/dev/null || true)"
      # Xen guests expose the /dev/sdX attachment as /dev/xvdX, so derive the
      # alias instead of hardcoding it separately from the attachment device.
      readonly xen_attachment_device="/dev/xvd$${requested_attachment_device#/dev/sd}"

      log() {
        printf '[beach-observability] %s\n' "$*"
      }

      fail() {
        log "ERROR: $*"
        exit 1
      }

      install_asset() {
        local source_path="$1"
        local destination_path="$2"
        local temporary_path

        temporary_path="$(mktemp "$${destination_path}.XXXXXX")"
        install -m 0644 "$source_path" "$temporary_path"
        mv -f "$temporary_path" "$destination_path"
      }

      discover_devices() {
        local normalized_volume_id="$1"
        local candidate

        lsblk -dn -o PATH,SERIAL,TYPE | awk -v expected="$normalized_volume_id" '$2 == expected && $3 == "disk" { print $1 }'

        if [[ "$virtualization_type" == "xen" ]]; then
          for candidate in "$requested_attachment_device" "$xen_attachment_device"; do
            if [[ -b "$candidate" ]]; then
              readlink -f "$candidate"
            fi
          done
        fi
      }

      normalized_volume_id="$(printf '%s' "$expected_volume_id" | tr -d '-')"
      [[ "$normalized_volume_id" == vol* ]] || fail "Invalid EBS volume ID: $expected_volume_id"

      device=""
      for ((attempt = 1; attempt <= device_wait_seconds; attempt++)); do
        mapfile -t candidates < <(discover_devices "$normalized_volume_id" | sort -u)

        if (( $${#candidates[@]} == 1 )); then
          device="$${candidates[0]}"
          break
        fi

        if (( $${#candidates[@]} > 1 )); then
          fail "Multiple candidate data devices found: $${candidates[*]}"
        fi

        sleep 1
      done

      [[ -n "$device" ]] || fail "Expected EBS volume was not safely identified within $device_wait_seconds seconds"
      [[ -b "$device" ]] || fail "Resolved EBS device is not a block device: $device"
      [[ "$(lsblk -dn -o TYPE "$device")" == "disk" ]] || fail "Resolved EBS device is not a whole disk: $device"

      if lsblk -nrpo TYPE "$device" | grep -Fxq part; then
        fail "Partitions were found on the data device: $device"
      fi

      if lsblk -nrpo MOUNTPOINT "$device" | grep -Fxq /; then
        fail "Refusing to use the root filesystem device: $device"
      fi

      existing_mount="$(findmnt -rn -S "$device" -o TARGET || true)"
      if [[ -n "$existing_mount" && "$existing_mount" != "$mount_point" ]]; then
        fail "Data device is already mounted at an unexpected path: $existing_mount"
      fi

      filesystem_type="$(blkid -s TYPE -o value "$device" || true)"
      if [[ -z "$filesystem_type" ]]; then
        log "Creating ext4 filesystem on $device"
        mkfs.ext4 "$device"
      elif [[ "$filesystem_type" != "ext4" ]]; then
        fail "Unexpected filesystem type on $device: $filesystem_type"
      else
        log "Preserving existing ext4 filesystem on $device"
      fi

      filesystem_uuid="$(blkid -s UUID -o value "$device")"
      [[ -n "$filesystem_uuid" ]] || fail "Unable to read filesystem UUID from $device"

      install -d -m 0755 "$mount_point"
      fstab_candidate="$(mktemp /run/beach-observability-fstab.XXXXXX)"
      awk -v target="$mount_point" 'NF < 2 || $2 != target { print }' /etc/fstab > "$fstab_candidate"
      printf 'UUID=%s %s ext4 defaults,nofail 0 2\n' "$filesystem_uuid" "$mount_point" >> "$fstab_candidate"
      findmnt --verify --tab-file "$fstab_candidate"
      install -m 0644 "$fstab_candidate" /etc/fstab
      rm -f "$fstab_candidate"

      if ! mountpoint -q "$mount_point"; then
        mount "$mount_point"
      fi

      mountpoint -q "$mount_point" || fail "Mount point verification failed: $mount_point"
      mounted_uuid="$(findmnt -n -o UUID --target "$mount_point")"
      [[ "$mounted_uuid" == "$filesystem_uuid" ]] || fail "Mounted filesystem UUID does not match the expected EBS UUID"

      python3 -m json.tool /etc/docker/daemon.json >/dev/null
      # Install Docker only after the EBS mount is verified so package auto-start passes the mount guard.
      apt-get install --yes docker.io docker-compose-v2
      systemctl daemon-reload
      systemctl enable --now docker
      systemctl is-enabled --quiet docker || fail "Docker service is not enabled"
      systemctl is-active --quiet docker || fail "Docker service is not active"
      docker version
      docker compose version
      /usr/local/sbin/verify-observability-mount healthy

      readonly staging_directory="/run/beach-observability"
      readonly compose_directory="$mount_point/compose"
      readonly data_directory="$mount_point/data"

      install -d -m 0755 \
        "$compose_directory/prometheus" \
        "$compose_directory/tempo" \
        "$compose_directory/grafana/provisioning/datasources"
      install -d -m 0755 -o 65534 -g 65534 "$data_directory/prometheus"
      install -d -m 0755 -o 10001 -g 10001 "$data_directory/tempo"
      install -d -m 0755 -o 472 -g 0 "$data_directory/grafana"

      install_asset "$staging_directory/docker-compose.yml" "$compose_directory/docker-compose.yml"
      install_asset "$staging_directory/prometheus.yml" "$compose_directory/prometheus/prometheus.yml"
      install_asset "$staging_directory/tempo.yaml" "$compose_directory/tempo/tempo.yaml"
      install_asset "$staging_directory/grafana-datasources.yml" "$compose_directory/grafana/provisioning/datasources/datasources.yml"

      docker compose --project-directory "$compose_directory" config --quiet
      systemctl daemon-reload
      systemctl enable --now beach-observability.service
      systemctl is-active --quiet beach-observability.service || fail "Observability service is not active"

      if id ubuntu >/dev/null 2>&1; then
        usermod -aG docker ubuntu
      fi

      log "Bootstrap completed successfully"

runcmd:
  - ["/usr/local/sbin/bootstrap-beach-observability", "${observability_volume_id}", "${requested_attachment_device}", "${mount_point}"]
