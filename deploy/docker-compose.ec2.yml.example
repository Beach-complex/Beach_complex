services:
  app:
    image: ${IMAGE_REPOSITORY}:${IMAGE_TAG}
    container_name: beach-complex-backend
    restart: unless-stopped
    labels:
      beach.logs: backend
    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "5"
        compress: "false"
        labels: "beach.logs"
    env_file:
      - ${APP_RUNTIME_ENV_FILE:-.env}
    ports:
      - "8080:8080"
      - "8081:8081"
