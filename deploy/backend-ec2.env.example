SPRING_DATASOURCE_URL=jdbc:postgresql://<db-host>:5432/beach_complex
SPRING_DATASOURCE_USERNAME=<db-user>
SPRING_DATASOURCE_PASSWORD=<db-password>
SPRING_REDIS_HOST=<redis-host>
SPRING_REDIS_PORT=6379
JWT_SECRET=<jwt-secret>
SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=8081
APP_FIREBASE_ENABLED=false
APP_FIREBASE_CREDENTIALS_PATH=
APP_FIREBASE_CREDENTIALS_JSON_BASE64=
APP_EMAIL_VERIFICATION_BASE_URL=https://<your-domain>/api/auth/verify-email
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
APP_EMAIL_FROM_ADDRESS=
# Required when APP_MAIL_ENABLED=true: generate once with `openssl rand -base64 32`; same key on every email worker.
# Preserve this secret across restarts; drain outstanding jobs before rotation.
APP_EMAIL_JOBS_PAYLOAD_KEY=
APP_EMAIL_JOBS_POLLING_ENABLED=true
APP_EMAIL_JOBS_POLL_INTERVAL_MS=1000
APP_EMAIL_JOBS_LEASE_SECONDS=300
